# Google Forms — preenche quando tiveres o link do formulário
# URL de envio (termina em /formResponse):
VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/SEU_FORM_ID/formResponse
# ID do campo de texto longo com o resumo da reserva (ex.: entry.123456789):
VITE_GOOGLE_FORM_ENTRY_RESUMO=entry.000000000

# Opcional — campos separados no Google Form
# VITE_GOOGLE_FORM_ENTRY_NOME=entry.111111111
# VITE_GOOGLE_FORM_ENTRY_EMAIL=entry.222222222
# VITE_GOOGLE_FORM_ENTRY_TELEFONE=entry.333333333
