# Resend — https://resend.com/api-keys
# Vercel → Settings → Environment Variables (Production + Preview).
# Nomes EXACTOS (maiúsculas). Sem prefixo VITE_. Depois: Redeploy obrigatório.

RESEND_API_KEY=re_xxxxxxxx
BOOKING_TO_EMAIL=oseu-email@gmail.com

# Testes Resend (sem domínio verificado):
#   FROM = onboarding@resend.dev
#   TO   = o mesmo email da conta Resend
BOOKING_FROM_EMAIL=Chalé do Avô Bedi <onboarding@resend.dev>

# Com domínio verificado na Resend:
# BOOKING_FROM_EMAIL=Chalé do Avô Bedi <reservas@seudominio.pt>

# Redis (Upstash) — bloqueio de datas + gestão em /gestao
# Vercel → Storage → Upstash Redis → Connect to project (injecta KV_* ou UPSTASH_*)
ADMIN_SECRET=escolha-uma-palavra-passe-longa-e-secreta

# Fase 1 — dados de pagamento no email ao hóspede (Vercel)
PAYMENT_MBWAY=+351 912 345 678
PAYMENT_IBAN=PT50 0000 0000 0000 0000 0000 0
PAYMENT_REVOLUT=https://revolut.me/seu-link

# Fase 2 (mais tarde) — só aparecem no email se estiverem definidas
# PAYMENT_MULTIBANCO=Entidade … · Referência …
